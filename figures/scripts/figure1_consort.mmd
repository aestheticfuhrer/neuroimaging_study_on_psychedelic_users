        LE["psy-exp"]:::psyexp
        LN["psy-naiv"]:::psynaiv
        LX["excluded"]:::excluded
    end

    classDef psyexp   fill:#bcbddc,stroke:#756bb1,stroke-width:2px,color:#1a1a1a;
    classDef psynaiv  fill:#fdae6b,stroke:#e6550d,stroke-width:2px,color:#1a1a1a;
    classDef neutral  fill:#efedf5,stroke:#9e9ac8,stroke-width:1.5px,color:#1a1a1a;
    classDef screen   fill:#f2f2f2,stroke:#969696,stroke-width:1px,color:#1a1a1a;
    classDef excluded fill:#f9d6d5,stroke:#c0392b,stroke-width:1.5px,color:#7b241c;
    class legend neutral;
